{
  "name": "@t2t/backend",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "db:dev": "node scripts/dev-db.mjs",
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1126.0",
    "@aws-sdk/s3-request-presigner": "^3.1126.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^10.1.1",
    "@t2t/shared": "workspace:*",
    "argon2": "^0.41.1",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.1.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.28.1",
    "embedded-postgres": "17.10.0-beta.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
