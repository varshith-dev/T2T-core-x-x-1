# Postgres (Neon connection string, or any Postgres URL)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# API
PORT=3000
NODE_ENV=development

# Cloudflare R2 (S3-compatible) — fill when wiring image storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=t2t-images
R2_PUBLIC_BASE_URL=

# ML service
ML_SERVICE_URL=http://localhost:8000
ML_CONFIDENCE_THRESHOLD=0.75

# Bootstrap admin (created on first boot if no admin exists)
ADMIN_EMAIL=admin@t2t.local
ADMIN_PASSWORD=change-me
